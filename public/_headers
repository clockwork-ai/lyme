# Browser caching for files that rarely change (Workers static assets read this file; it is not served).
# Names are not fingerprinted, so photos and drawings keep a week; a replaced photo should get a new file name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/scene/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/photos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/illustrations/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/maps/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
